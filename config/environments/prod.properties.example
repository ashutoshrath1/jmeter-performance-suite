# Production Environment Configuration Example
environment=prod
protocol=https
host=api.example.com
port=443
base_url=${protocol}://${host}
health.path=/health
health.timeout.ms=3000
health.check.enabled=true
auto_open_reports=false

# Load profile overrides, per plan.
# Each plan ships its own defaults in test-plans/*.jmx; anything set here wins.
# Keys are <plan>.<setting> where plan is one of:
#   baseline, spike, stress, endurance, breakpoint
# Production is deliberately gentler than the JMX defaults.
baseline.target_level=50
baseline.ramp_up=60
baseline.hold_time=300

# SLA Thresholds. A threshold of 0 disables that gate.
# p95_response_time_ms gates the 95th percentile, not the absolute maximum.
p95_response_time_ms=1000
max_error_rate_percent=0.1
min_throughput_tps=20

# Metric streaming. Off by default. When enabled, samples stream to a time-series backend
# during the run so results accumulate into a trend instead of being one-off files.
# metrics.arg.* entries are passed through to the client verbatim.
#metrics.enabled=true
#metrics.classname=org.apache.jmeter.visualizers.backend.influxdb.InfluxdbBackendListenerClient
#metrics.queue.size=5000
#metrics.arg.influxdbUrl=http://localhost:8086/write?db=jmeter
#metrics.arg.application=jmeter-performance-suite
